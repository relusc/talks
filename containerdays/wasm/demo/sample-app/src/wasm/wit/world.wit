package relusc:containerdays;

// "simpleweb" is the WIT world for our component. 

// `wasi:http/proxy` is the standard WASI-defined world for an HTTP
// server/proxy component: it exports `wasi:http/incoming-handler` and
// imports exactly what a plain HTTP component needs (outgoing-handler,
// clocks, io, etc). This is the world `wasmtime serve` implements natively.
world simpleweb {
    include wasi:http/proxy@0.2.0;
    import wasi:cli/environment@0.2.0;
    import wasi:filesystem/types@0.2.0;
    import wasi:filesystem/preopens@0.2.0;
}
